<UserControl x:Class="UefiDevExtension.Options.UefiOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="640"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UefiDevExtension;component/Themes/UefiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ScrollViewerStyleKey}}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,14,16,4" MaxWidth="820" HorizontalAlignment="Stretch">

            <!-- ============================================================ Header -->
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="7" Margin="0,0,11,0"
                        Background="{StaticResource Uefi.BrandBrush}">
                    <TextBlock Text="&#xE950;" Style="{StaticResource Uefi.Icon}" FontSize="17" Foreground="White"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UEFI Development Kit" Style="{StaticResource Uefi.Title}"/>
                    <TextBlock Text="Workspace, build and emulation defaults. Changes are saved when you select OK."
                               Style="{StaticResource Uefi.Subtitle}" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
            </DockPanel>

            <!-- ============================================================ Workspace -->
            <HeaderedContentControl Style="{StaticResource Uefi.Card}" Header="Workspace" Tag="&#xED25;">
                <StackPanel>
                    <TextBlock Text="EDK II root" Style="{StaticResource Uefi.Caption}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkspaceTextBox" Style="{StaticResource Uefi.MonoTextBox}"
                                 TextChanged="WorkspaceTextBox_TextChanged" AutomationProperties.Name="EDK II root"/>
                        <Button Grid.Column="1" Style="{StaticResource Uefi.Button}" Width="32" Padding="0" Margin="6,0,0,0"
                                FontFamily="{StaticResource Uefi.IconFont}" Content="&#xED25;" Click="BrowseWorkspace_Click"
                                ToolTip="Browse for the EDK II root folder" AutomationProperties.Name="Browse for the EDK II root folder"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="1,6,0,0">
                        <Ellipse x:Name="WorkspaceHintDot" Style="{StaticResource Uefi.StatusDot}" Width="7" Height="7" Margin="0,0,7,0"/>
                        <TextBlock x:Name="WorkspaceHintText" Style="{StaticResource Uefi.Hint}" Margin="0"/>
                    </StackPanel>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="optional · separate with ;" Style="{StaticResource Uefi.Caption}" Opacity="0.55"/>
                        <TextBlock Text="Packages path (PACKAGES_PATH)" Style="{StaticResource Uefi.Caption}"/>
                    </DockPanel>
                    <TextBox x:Name="PackagesPathTextBox" Style="{StaticResource Uefi.MonoTextBox}"
                             AutomationProperties.Name="Packages path"
                             ToolTip="Extra folders searched for packages, for example D:\edk2-platforms;D:\edk2-non-osi"/>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ============================================================ Build -->
            <HeaderedContentControl Style="{StaticResource Uefi.Card}" Header="Build" Tag="&#xE90F;">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Architecture" Style="{StaticResource Uefi.Caption}"/>
                            <ComboBox x:Name="ArchComboBox" Style="{StaticResource Uefi.ComboBox}" AutomationProperties.Name="Architecture">
                                <ComboBoxItem Content="X64"/>
                                <ComboBoxItem Content="IA32"/>
                                <ComboBoxItem Content="ARM"/>
                                <ComboBoxItem Content="AARCH64"/>
                                <ComboBoxItem Content="RISCV64"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Build target" Style="{StaticResource Uefi.Caption}"/>
                            <ComboBox x:Name="TargetComboBox" Style="{StaticResource Uefi.ComboBox}" AutomationProperties.Name="Build target">
                                <ComboBoxItem Content="DEBUG"/>
                                <ComboBoxItem Content="RELEASE"/>
                                <ComboBoxItem Content="NOOPT"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Parallel threads" Style="{StaticResource Uefi.Caption}"/>
                            <TextBox x:Name="ThreadsTextBox" Style="{StaticResource Uefi.TextBox}"
                                     TextChanged="ThreadsTextBox_TextChanged" AutomationProperties.Name="Parallel threads"
                                     ToolTip="Number of concurrent build threads (build -n)"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="ThreadsError" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE783;" Style="{StaticResource Uefi.Icon}" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{StaticResource Uefi.ErrorBrush}"/>
                        <TextBlock Text="Parallel threads must be a whole number from 1 to 512." FontSize="11.5"/>
                    </StackPanel>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="empty = Conf/target.txt default" Style="{StaticResource Uefi.Caption}" Opacity="0.55"/>
                        <TextBlock Text="Toolchain tag" Style="{StaticResource Uefi.Caption}"/>
                    </DockPanel>
                    <TextBox x:Name="ToolchainTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="Toolchain tag"
                             ToolTip="Tool chain tag from Conf/tools_def.txt, for example VS2022"/>

                    <TextBlock Text="Active platform (DSC)" Style="{StaticResource Uefi.Caption}" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DscTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="Active platform DSC file"
                                 ToolTip="Platform description file, relative to the workspace (for example OvmfPkg/OvmfPkgX64.dsc)"/>
                        <Button Grid.Column="1" Style="{StaticResource Uefi.Button}" Width="32" Padding="0" Margin="6,0,0,0"
                                FontFamily="{StaticResource Uefi.IconFont}" Content="&#xED25;" Click="BrowseDsc_Click"
                                ToolTip="Browse for a platform DSC file" AutomationProperties.Name="Browse for a platform DSC file"/>
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ============================================================ Emulation -->
            <HeaderedContentControl Style="{StaticResource Uefi.Card}" Header="QEMU &amp; OVMF emulation" Tag="&#xE7F4;">
                <StackPanel>
                    <TextBlock Text="QEMU executable" Style="{StaticResource Uefi.Caption}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QemuPathTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="QEMU executable"
                                 ToolTip="Full path to qemu-system-x86_64.exe, or just its name to look it up on PATH"/>
                        <Button Grid.Column="1" Style="{StaticResource Uefi.Button}" Width="32" Padding="0" Margin="6,0,0,0"
                                FontFamily="{StaticResource Uefi.IconFont}" Content="&#xE8E5;" Click="BrowseQemu_Click"
                                ToolTip="Browse for the QEMU executable" AutomationProperties.Name="Browse for the QEMU executable"/>
                    </Grid>

                    <TextBlock Text="OVMF firmware" Style="{StaticResource Uefi.Caption}" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OvmfPathTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="OVMF firmware file"
                                 ToolTip="Path to OVMF.fd. Leave empty to pick it up from the workspace Build folder."/>
                        <Button Grid.Column="1" Style="{StaticResource Uefi.Button}" Width="32" Padding="0" Margin="6,0,0,0"
                                FontFamily="{StaticResource Uefi.IconFont}" Content="&#xE8E5;" Click="BrowseOvmf_Click"
                                ToolTip="Browse for an OVMF firmware image" AutomationProperties.Name="Browse for an OVMF firmware image"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Guest memory" Style="{StaticResource Uefi.Caption}"/>
                            <TextBox x:Name="MemoryTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="Guest memory"
                                     ToolTip="Memory for the virtual machine, for example 512M or 2G"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="shows up as fs0:" Style="{StaticResource Uefi.Caption}" Opacity="0.55"/>
                                <TextBlock Text="Shared folder (virtual FAT)" Style="{StaticResource Uefi.Caption}"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VfatTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="Shared folder"
                                         ToolTip="Optional folder mounted as a FAT drive inside the UEFI Shell"/>
                                <Button Grid.Column="1" Style="{StaticResource Uefi.Button}" Width="32" Padding="0" Margin="6,0,0,0"
                                        FontFamily="{StaticResource Uefi.IconFont}" Content="&#xED25;" Click="BrowseVfat_Click"
                                        ToolTip="Browse for the shared folder" AutomationProperties.Name="Browse for the shared folder"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Additional QEMU arguments" Style="{StaticResource Uefi.Caption}" Margin="0,12,0,4"/>
                    <TextBox x:Name="ExtraArgsTextBox" Style="{StaticResource Uefi.MonoTextBox}" AutomationProperties.Name="Additional QEMU arguments"
                             ToolTip="Appended to the QEMU command line, for example -serial stdio -net none"/>

                    <DockPanel Margin="0,14,0,0">
                        <Button x:Name="AutoDetectButton" DockPanel.Dock="Left" Style="{StaticResource Uefi.Button}"
                                Tag="&#xE721;" Content="Auto-detect QEMU and OVMF" Click="AutoDetect_Click"/>
                        <StackPanel x:Name="AutoDetectStatus" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Ellipse x:Name="AutoDetectDot" Style="{StaticResource Uefi.StatusDot}" Width="7" Height="7" Margin="0,0,7,0"/>
                            <TextBlock x:Name="AutoDetectText" Style="{StaticResource Uefi.Hint}" Margin="0" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </HeaderedContentControl>

            <!-- ============================================================ Output -->
            <HeaderedContentControl Style="{StaticResource Uefi.Card}" Header="Output window" Tag="&#xE8A5;">
                <StackPanel>
                    <CheckBox x:Name="ClearOutputCheckBox" Style="{StaticResource Uefi.CheckBox}"
                              Content="Clear the UEFI Development pane before each build"/>
                    <CheckBox x:Name="TimestampCheckBox" Style="{StaticResource Uefi.CheckBox}" Margin="0"
                              Content="Start each output line with a timestamp"/>
                </StackPanel>
            </HeaderedContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
