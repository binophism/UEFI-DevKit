<!--
    Shared styles for the UEFI Dev Kit tool window and options page.

    Every colour that touches text or a control surface comes from the active Visual Studio theme
    (EnvironmentColors / CommonControlsColors), so Light, Dark, Blue and High Contrast all render
    correctly. The only fixed colours are the status accents, which are used for shapes (dots, bars,
    icons) and never for body text, plus the green Run button, whose white label keeps 5:1 contrast.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">

    <!-- ============================================================ Tokens -->
    <SolidColorBrush x:Key="Uefi.SuccessBrush" Color="#2EA043"/>
    <SolidColorBrush x:Key="Uefi.WarningBrush" Color="#D29922"/>
    <SolidColorBrush x:Key="Uefi.ErrorBrush" Color="#E5534B"/>
    <SolidColorBrush x:Key="Uefi.NeutralBrush" Color="#8B949E"/>
    <SolidColorBrush x:Key="Uefi.BrandBrush" Color="#C8102E"/>
    <SolidColorBrush x:Key="Uefi.RunBrush" Color="#2E7D46"/>
    <SolidColorBrush x:Key="Uefi.RunHoverBrush" Color="#276B3C"/>
    <SolidColorBrush x:Key="Uefi.RunPressedBrush" Color="#1F5730"/>

    <FontFamily x:Key="Uefi.IconFont">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Uefi.MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================================================ Focus -->
    <Style x:Key="Uefi.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="5" RadiusY="5" StrokeThickness="1" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource {x:Static vsui:CommonControlsColors.FocusVisualBrushKey}}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Typography -->
    <Style x:Key="Uefi.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Uefi.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="Uefi.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Opacity" Value="0.78"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Uefi.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Opacity" Value="0.65"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Uefi.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Uefi.IconFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================ Card
         Usage: <HeaderedContentControl Style="{StaticResource Uefi.Card}" Header="Title" Tag="glyph">
         The faint fill is the theme's own text colour at 4% opacity, so it lifts the card slightly in
         dark themes and shades it slightly in light themes. -->
    <Style x:Key="Uefi.Card" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="14,12,14,14"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid SnapsToDevicePixels="True">
                        <Border CornerRadius="6" Opacity="0.04"
                                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                        <Border CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" Style="{StaticResource Uefi.Icon}"
                                               FontSize="14" Margin="0,0,9,0"
                                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.AccentMediumBrushKey}}"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.FontSize="13" TextElement.FontWeight="SemiBold"/>
                                </DockPanel>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Text boxes -->
    <Style x:Key="Uefi.TextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBackgroundBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderBrushKey}}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextBrushKey}}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBorderHoverBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderFocusedBrushKey}}"/>
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBackgroundFocusedBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextFocusedBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="error">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Uefi.ErrorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBackgroundDisabledBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxBorderDisabledBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.TextBoxTextDisabledBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Paths, toolchain tags, arguments -->
    <Style x:Key="Uefi.MonoTextBox" TargetType="TextBox" BasedOn="{StaticResource Uefi.TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource Uefi.MonoFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- Read-only generated output that wraps instead of being clipped -->
    <Style x:Key="Uefi.CodeBox" TargetType="TextBox" BasedOn="{StaticResource Uefi.MonoTextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ============================================================ Combo box -->
    <ControlTemplate x:Key="Uefi.ComboToggleTemplate" TargetType="ToggleButton">
        <Border Background="Transparent"/>
    </ControlTemplate>

    <Style x:Key="Uefi.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListItemTextBrushKey}}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Margin="3,1" CornerRadius="3" BorderThickness="1"
                            Background="Transparent" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListItemBackgroundHoverBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListItemBorderHoverBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListItemTextHoverBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListItemTextDisabledBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Uefi.ComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="9,0,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxTextBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBackgroundBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBorderBrushKey}}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Uefi.ComboBoxItem}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Path x:Name="Arrow" Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" StrokeThickness="1.4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Stroke="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxGlyphBrushKey}}"/>
                        </Grid>
                        <ToggleButton Template="{StaticResource Uefi.ComboToggleTemplate}" Focusable="False" IsTabStop="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="DropDown" Margin="0,0,8,8" CornerRadius="4" BorderThickness="1" Padding="0,3"
                                    MinWidth="{Binding ActualWidth, ElementName=Root}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListBackgroundBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxListBorderBrushKey}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBackgroundHoverBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBorderHoverBrushKey}}"/>
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxGlyphHoverBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxTextHoverBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBackgroundFocusedBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBorderFocusedBrushKey}}"/>
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxGlyphFocusedBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxTextFocusedBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBackgroundPressedBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBorderPressedBrushKey}}"/>
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxGlyphPressedBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxTextPressedBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBackgroundDisabledBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxBorderDisabledBrushKey}}"/>
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxGlyphDisabledBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.ComboBoxTextDisabledBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Buttons
         Set Tag to a Segoe MDL2 glyph to show an icon before the label. -->
    <Style x:Key="Uefi.Button" TargetType="Button">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonTextBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderBrushKey}}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Uefi.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" Style="{StaticResource Uefi.Icon}"
                                       Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonHoverBrushKey}}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderHoverBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonHoverTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonPressedBrushKey}}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderPressedBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonPressedTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDisabledBrushKey}}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDisabledBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDisabledTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The theme's "default button" colours: guaranteed readable in every theme, High Contrast included -->
    <Style x:Key="Uefi.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Uefi.Button}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDefaultTextBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonDefaultBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:CommonControlsColors.ButtonBorderDefaultBrushKey}}"/>
    </Style>

    <Style x:Key="Uefi.RunButton" TargetType="Button" BasedOn="{StaticResource Uefi.Button}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                            Background="{StaticResource Uefi.RunBrush}" BorderBrush="{StaticResource Uefi.RunBrush}">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" Style="{StaticResource Uefi.Icon}"
                                       Foreground="White" Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Uefi.RunHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Uefi.RunHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Uefi.RunPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Uefi.RunPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square, borderless glyph button for toolbar-style actions (copy, refresh, settings) -->
    <Style x:Key="Uefi.IconButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontFamily" Value="{StaticResource Uefi.IconFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Uefi.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarHoverBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:EnvironmentColors.CommandBarMouseDownBackgroundMiddleBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Check box -->
    <Style x:Key="Uefi.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxTextBrushKey}}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBackgroundBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBorderBrushKey}}">
                            <Path x:Name="Glyph" Data="M 2.5,7 L 5.5,10 L 11.5,3.5" StrokeThickness="1.6" Visibility="Collapsed"
                                  Stroke="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxGlyphBrushKey}}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBackgroundHoverBrushKey}}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBorderHoverBrushKey}}"/>
                            <Setter TargetName="Glyph" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxGlyphHoverBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBackgroundFocusedBrushKey}}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBorderFocusedBrushKey}}"/>
                            <Setter TargetName="Glyph" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxGlyphFocusedBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBackgroundPressedBrushKey}}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBorderPressedBrushKey}}"/>
                            <Setter TargetName="Glyph" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxGlyphPressedBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBackgroundDisabledBrushKey}}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxBorderDisabledBrushKey}}"/>
                            <Setter TargetName="Glyph" Property="Stroke"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxGlyphDisabledBrushKey}}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource {x:Static vsui:CommonControlsColors.CheckBoxTextDisabledBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ Status -->
    <Style x:Key="Uefi.StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{StaticResource Uefi.NeutralBrush}"/>
    </Style>

    <!-- Inline message strip. Code-behind sets BorderBrush, the tint and the icon. -->
    <Style x:Key="Uefi.Callout" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

</ResourceDictionary>
