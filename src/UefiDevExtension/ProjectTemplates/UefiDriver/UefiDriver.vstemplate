<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>UEFI DXE Driver (EDK II)</Name>
    <TemplateID>Uefi.Driver.Project</TemplateID>
    <Description>Creates a new C-based UEFI DXE (Driver Execution Environment) Driver project for EDK II / TianoCore with INF, DSC, and C source files.</Description>
    <ProjectType>VC</ProjectType>
    <SortOrder>20</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>UefiDriver</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <CreateInPlace>true</CreateInPlace>
    <Icon>__TemplateIcon.ico</Icon>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Other</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.vcxproj" File="Project.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.c">DriverEntry.c</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.inf">UefiDriver.inf</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.dsc">UefiDriver.dsc</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
