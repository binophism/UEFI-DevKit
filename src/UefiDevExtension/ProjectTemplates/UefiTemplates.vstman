<VSTemplateManifest Version="1.0" xmlns="http://schemas.microsoft.com/developer/vstemplatemanifest/2015">
  <VSTemplateContainer TemplateType="Project">
    <RelativePathOnDisk>UefiApplication</RelativePathOnDisk>
    <TemplateFileName>UefiApplication.vstemplate</TemplateFileName>
    <VSTemplateHeader>
      <TemplateData xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
        <Name>UEFI Application (EDK II)</Name>
        <TemplateID>Uefi.Application.Project</TemplateID>
        <Description>Creates a new C-based UEFI Application project for EDK II / TianoCore with INF, DSC, and C source files, ready to build and run in QEMU.</Description>
        <ProjectType>VC</ProjectType>
        <SortOrder>10</SortOrder>
        <CreateNewFolder>true</CreateNewFolder>
        <DefaultName>UefiApp</DefaultName>
        <ProvideDefaultName>true</ProvideDefaultName>
        <LocationField>Enabled</LocationField>
        <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
        <CreateInPlace>true</CreateInPlace>
        <Icon>__TemplateIcon.ico</Icon>
        <LanguageTag>C++</LanguageTag>
        <PlatformTag>Windows</PlatformTag>
        <ProjectTypeTag>Other</ProjectTypeTag>
      </TemplateData>
    </VSTemplateHeader>
  </VSTemplateContainer>
  <VSTemplateContainer TemplateType="Project">
    <RelativePathOnDisk>UefiDriver</RelativePathOnDisk>
    <TemplateFileName>UefiDriver.vstemplate</TemplateFileName>
    <VSTemplateHeader>
      <TemplateData xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
        <Name>UEFI DXE Driver (EDK II)</Name>
        <TemplateID>Uefi.Driver.Project</TemplateID>
        <Description>Creates a new C-based UEFI DXE (Driver Execution Environment) Driver project for EDK II / TianoCore with INF, DSC, and C source files.</Description>
        <ProjectType>VC</ProjectType>
        <SortOrder>20</SortOrder>
        <CreateNewFolder>true</CreateNewFolder>
        <DefaultName>UefiDriver</DefaultName>
        <ProvideDefaultName>true</ProvideDefaultName>
        <LocationField>Enabled</LocationField>
        <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
        <CreateInPlace>true</CreateInPlace>
        <Icon>__TemplateIcon.ico</Icon>
        <LanguageTag>C++</LanguageTag>
        <PlatformTag>Windows</PlatformTag>
        <ProjectTypeTag>Other</ProjectTypeTag>
      </TemplateData>
    </VSTemplateHeader>
  </VSTemplateContainer>
</VSTemplateManifest>
