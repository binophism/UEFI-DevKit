[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = $safeprojectname$
  FILE_GUID                      = $guid2$
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

[Sources]
  $safeprojectname$.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  BaseLib
  DebugLib
