<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>UEFI Application (EDK II)</Name>
    <TemplateID>Uefi.Application.Project</TemplateID>
    <Description>Creates a new C-based UEFI Application project for EDK II / TianoCore with INF, DSC, and C source files, ready to build and run in QEMU.</Description>
    <ProjectType>VC</ProjectType>
    <SortOrder>10</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>UefiApp</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <CreateInPlace>true</CreateInPlace>
    <Icon>__TemplateIcon.ico</Icon>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>Windows</PlatformTag>
    <ProjectTypeTag>Other</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.vcxproj" File="Project.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.c">UefiMain.c</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.inf">UefiApp.inf</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$safeprojectname$.dsc">UefiApp.dsc</ProjectItem>
    </Project>
  </TemplateContent>
</VSTemplate>
